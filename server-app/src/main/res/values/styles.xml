<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform shows this theme before Compose draws its first frame. -->
    <style name="Theme.Navelo" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowBackground">@drawable/navelo_launch</item>
        <item name="android:statusBarColor">@color/navelo_launch_background</item>
        <item name="android:navigationBarColor">@color/navelo_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
